{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "hotk-backend": {
      "root": "backend",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend",
      "framework": "create-react-app",
      "installCommand": "yarn install",
      "buildCommand": "CI=false yarn build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "hotk-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
